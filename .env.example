# Optional AniList collection settings
ANILIST_REQUEST_DELAY=1.5
ANILIST_MAX_RETRIES=5
ANILIST_TIMEOUT=30
PERSONAL_REC_ANILIST_DIR=
PERSONAL_REC_DATA_DIR=
# AniList does not require an access token for public data.
# If you later add authenticated endpoints, put the token in .env (never commit it).
ANILIST_ACCESS_TOKEN=
